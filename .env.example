SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SECRET_KEY=replace-with-server-only-secret-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_DB_PASSWORD=replace-with-database-password

API_HOST=127.0.0.1
API_PORT=4000
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
OFFLINE_CHECK_INTERVAL_MS=30000
SIMULATOR_DEVICE_KEY=replace-with-a-long-random-device-token
ADMIN_API_KEY=replace-with-a-different-long-random-admin-token

SIMULATOR_HOST=127.0.0.1
SIMULATOR_PORT=4100
SIMULATOR_CONTROL_ENABLED=false
SIMULATOR_SCENARIO=normal
SIMULATOR_RETRY_ATTEMPTS=1

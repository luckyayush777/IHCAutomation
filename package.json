{
  "name": "ihc-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Environmental and medicine-fridge monitoring for the institute health centre.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "simulator"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names dashboard,api,simulator --prefix-colors cyan,green,yellow \"npm:dev:dashboard\" \"npm:dev:api\" \"npm:dev:simulator\"",
    "dev:dashboard": "npm run dev --workspace @ihc/dashboard",
    "dev:api": "npm run dev --workspace @ihc/api",
    "dev:simulator": "npm run dev --workspace @ihc/simulator",
    "build": "npm run build --workspace @ihc/shared && npm run build --workspace @ihc/api && npm run build --workspace @ihc/simulator && npm run build --workspace @ihc/dashboard",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "supabase": "^2.114.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1"
  }
}
